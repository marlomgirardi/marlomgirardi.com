---
import BlurImage from '@/components/BlurImage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('articles')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout>
			<section class="flex grow w-full max-w-230">
				<ul class="md:gap-8 gap-2 flex flex-wrap list-none flex-col m-0 p-0">
					{
						posts.map((post) => (
							<li class={'px-4 lg:px-0 md:first:text-4xl first:w-full first:mb-4 first:text-center text-center md:text-left md:w-[calc(50%-1rem)] text-zinc-300 hover:text-zinc-50 hover:brightness-125 transition-all'}>
								<a href={`/articles/${post.id}/`} class="after:content-none hover:opacity-100">
										{post.data.heroImage && <div class="aspect-video w-full rounded-xl mb-4 overflow-hidden" transition:name={`hero-${post.id}`} data-article-id={post.id}><BlurImage width={720} height={360} src={post.data.heroImage} class='w-full h-full' alt="" /></div>}
									<h4 class="title leading-none m-0" transition:name={`title-${post.id}`} data-article-id-title={post.id}>{post.data.title}</h4>
								</a>
							</li>
						))
					}
				</ul>
			</section>
</BaseLayout>
