---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
		<main class="flex grow max-w-230">
			<div class="w-max[300px] self-center">
				<h1 class="text-4xl font-semibold text-transparent bg-clip-text bg-linear-to-r from-zinc-400 to-zinc-50">
					Marlom Girardi
				</h1>
				<p class="mt-6">
						Senior <span class="product-minded">product-minded
							<svg class="underline-svg select-none" viewBox="0 0 200 8" preserveAspectRatio="none" aria-hidden="true">
								<defs>
									<linearGradient id="blue-gradient" x1="0" y1="0" x2="1" y2="0">
										<stop offset="0%" stop-color="#a855f7" />
										<stop offset="100%" stop-color="#3b82f6" />
									</linearGradient>
								</defs>
								<path
									d="M0 5 C 20 2, 40 8, 70 4 S 120 7, 150 3 S 180 6, 200 5"
									fill="none"
									stroke="url(#blue-gradient)"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span> Software Engineer
					<br />
					<span class="leading-9 text-zinc-400">Creating awesome experiences</span>
				</p>
			</div>
		</main>
</BaseLayout>

<style>
	.product-minded {
		position: relative;
	}

	.underline-svg {
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 100%;
		height: 8px;
		overflow: visible;
	}

	.underline-svg path {
		stroke-dasharray: 350;
		stroke-dashoffset: 350;
		transition: stroke-dashoffset 0.15s ease-in;
	}

	.product-minded:hover .underline-svg path {
		stroke-dashoffset: 0;
		transition: stroke-dashoffset 0.6s cubic-bezier(0.65, 0, 0.35, 1);
	}
</style>
